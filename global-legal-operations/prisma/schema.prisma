// ═══════════════════════════════════════════════════════════════
// Global Legal Operations Platform — Prisma Schema (Phase 0 Initial)
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (mirrors @glo/shared/enums) ───

enum LegalRequestStatus {
  draft
  submitted
  triaged
  in_progress
  converted_to_matter
  closed
  cancelled
  rejected
  waiting_for_information
}

enum MatterStatus {
  open
  in_progress
  on_hold
  waiting_for_information
  resolved
  closed
  archived
  cancelled
}

enum ContractStatus {
  draft
  under_review
  changes_requested
  pending_approval
  approved
  pending_signature
  signed
  active
  expired
  terminated
  archived
  rejected
  draft_new_version
}

enum DocumentStatus {
  draft
  under_review
  changes_requested
  approved
  exported
  filed
  archived
}

enum ApprovalDecision {
  approved
  rejected
  changes_requested
}

enum ApprovalStepType {
  sequential
  parallel
}

enum ConflictCheckStatus {
  not_checked
  no_match
  possible_match
  requires_review
  cleared_by_lawyer
  blocked
}

enum SignatureStatus {
  pending
  signed
  declined
  unknown
}

enum NotificationStatus {
  unread
  read
  delivered
  failed
}

enum ClassificationLevel {
  public
  internal
  confidential
  restricted
}

enum VirusScanStatus {
  pending
  clean
  infected
  error
}

// ═══════════════════════════════════════════════════════════════
// Core Tables
// ═══════════════════════════════════════════════════════════════

model Organization {
  id          String   @id @default(uuid())
  name        String
  nameEn      String?  @map("name_en")
  slug        String   @unique
  countryPack String?  @map("country_pack")
  settings    Json?    @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  rowVersion  Int      @default(0) @map("row_version")

  settingsRel  OrganizationSetting?
  entities     Entity[]
  departments  Department[]
  users        User[]
  roles        Role[]

  @@map("organizations")
}

model OrganizationSetting {
  id              String @id @default(uuid())
  organizationId  String @unique @map("organization_id")
  defaultLocale   String @default("ar") @map("default_locale")
  defaultTimezone String @default("Asia/Amman") @map("default_timezone")
  defaultCurrency String @default("JOD") @map("default_currency")
  mfaMandatory    Boolean @default(false) @map("mfa_mandatory")
  retentionDays   Int?   @map("retention_days")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_settings")
}

model Entity {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String
  nameEn         String? @map("name_en")
  legalName      String? @map("legal_name")
  registrationNo String? @map("registration_no")
  countryCode    String @map("country_code")
  entityType     String? @map("entity_type")
  isActive       Boolean @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  rowVersion     Int @default(0) @map("row_version")

  organization Organization @relation(fields: [organizationId], references: [id])
  departments   Department[]

  @@unique([organizationId, registrationNo])
  @@map("entities")
}

model Department {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  entityId       String @map("entity_id")
  name           String
  nameEn         String? @map("name_en")
  isActive       Boolean @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  entity       Entity       @relation(fields: [entityId], references: [id])

  @@map("departments")
}

model User {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  email          String
  passwordHash   String @map("password_hash")
  firstName      String @map("first_name")
  firstNameEn    String? @map("first_name_en")
  lastName       String @map("last_name")
  lastNameEn     String? @map("last_name_en")
  displayName    String @map("display_name")
  avatarUrl      String? @map("avatar_url")
  isActive       Boolean @default(true) @map("is_active")
  mfaEnabled     Boolean @default(false) @map("mfa_enabled")
  mfaSecret      String? @map("mfa_secret")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  rowVersion     Int @default(0) @map("row_version")

  organization Organization @relation(fields: [organizationId], references: [id])
  roles       UserRole[]

  @@unique([organizationId, email])
  @@map("users")
}

model Role {
  id             String @id @default(uuid())
  organizationId String? @map("organization_id")
  code           String @unique
  name           String
  nameEn         String? @map("name_en")
  description    String?
  isSystem       Boolean @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization? @relation(fields: [organizationId], references: [id])
  userRoles     UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String @id @default(uuid())
  code      String @unique
  name      String
  nameEn    String? @map("name_en")
  module    String
  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id             String @id @default(uuid())
  userId         String @map("user_id")
  roleId         String @map("role_id")
  assignedBy     String? @map("assigned_by")
  assignedAt     DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════════════════
// Audit Log
// ═══════════════════════════════════════════════════════════════

model AuditLog {
  id            String   @id @default(uuid())
  organizationId String  @map("organization_id")
  actorId       String   @map("actor_id")
  actorEmail    String?  @map("actor_email")
  action        String
  objectType    String   @map("object_type")
  objectId      String   @map("object_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  correlationId String   @map("correlation_id")
  before        Json?    @db.JsonB
  after         Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")
  hashChain     String?  @map("hash_chain")

  @@index([organizationId])
  @@index([actorId])
  @@index([objectType, objectId])
  @@index([createdAt])
  @@map("audit_logs")
}