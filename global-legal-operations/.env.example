# ─── Application ───
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://legalops:legalops_dev_password@localhost:5432/legalops
POSTGRES_PASSWORD=legalops_dev_password
POSTGRES_PORT=5432

# ─── Redis ───
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ─── S3-Compatible Storage (MinIO) ───
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=legalops
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Gotenberg (PDF/DOCX Export) ───
GOTENBERG_URL=http://localhost:3000
GOTENBERG_PORT=3000

# ─── JWT (RS256) ───
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# ─── MFA ───
MFA_ISSUER=GlobalLegalOperations

# ─── Upload ───
MAX_UPLOAD_BYTES=104857600

# ─── SSE ───
SSE_ENABLED=true

# ─── App URLs ───
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# ─── Locale Defaults ───
DEFAULT_LOCALE=ar-JO
DEFAULT_TIMEZONE=Asia/Amman
DEFAULT_CURRENCY=JOD

# ─── Docker Ports ───
API_PORT=3001
WEB_PORT=3000
