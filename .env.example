# ═══════════════════════════════════════════════════════════════
# CorpLegalWakeely — Environment Variables (ALL PHASES)
# ═══════════════════════════════════════════════════════════════
#
# WARNING: This file is an EXAMPLE only.
# Do NOT use default values in production.
# You MUST generate JWT keys, storage secrets, and database
# credentials BEFORE deploying to any environment.
#
# For Railway deployment:
#   1. Add a PostgreSQL plugin → DATABASE_URL is auto-set
#   2. Add a Redis plugin → REDIS_URL is auto-set
#   3. Deploy MinIO + Gotenberg as separate Docker services
#   4. Set the variables below in the Railway dashboard
# ═══════════════════════════════════════════════════════════════

# ─── Application ───
NODE_ENV=production
PORT=3001

# ─── Database (PostgreSQL) ───
# On Railway: provided automatically by the PostgreSQL plugin
DATABASE_URL=postgresql://legalops:legalops_dev_password@localhost:5432/legalops

# ─── Redis ───
# On Railway: provided automatically by the Redis plugin
REDIS_URL=redis://localhost:6379

# ─── S3-Compatible Storage (MinIO or AWS S3) ───
# On Railway: deploy MinIO as a separate Docker service, or use AWS S3
MINIO_ENDPOINT=http://minio:9000
S3_ENDPOINT=http://minio:9000
S3_BUCKET=legalops
S3_ACCESS_KEY=change-me-to-a-random-32-char-string
S3_SECRET_KEY=change-me-to-a-random-64-char-string
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ─── Gotenberg (PDF/DOCX Export — Phase 8) ───
# On Railway: deploy gotenberg/gotenberg:8 as a separate Docker service
GOTENBERG_URL=http://gotenberg:3000

# ─── JWT (RS256) ───
# In development: keys auto-generated in ./keys/
# In production: generate with:
#   openssl genrsa -out private.pem 4096
#   openssl rsa -in private.pem -pubout -out public.pem
# Then set the paths or paste the PEM content
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_KEYPAIR_DIR=./keys
# Alternative: set keys directly as env vars (PEM format)
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."

# ─── MFA (TOTP) ───
MFA_ISSUER=CorpLegalWakeely

# ─── Upload Limits ───
MAX_UPLOAD_BYTES=104857600

# ─── SSE (Server-Sent Events) ───
SSE_ENABLED=true

# ─── App URLs (set these to your Railway domain) ───
APP_BASE_URL=https://your-web-app.up.railway.app
API_BASE_URL=https://your-api.up.railway.app

# ─── Frontend (Next.js build-time env) ───
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app/api/v1

# ─── Email (Phase 6 stub — Phase 8 will wire real SMTP) ───
EMAIL_FROM=no-reply@yourdomain.com
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password

# ─── Locale Defaults ───
DEFAULT_LOCALE=ar
DEFAULT_TIMEZONE=Asia/Amman
DEFAULT_CURRENCY=JOD

# ─── Docker Ports (for local docker-compose only) ───
API_PORT=3001
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
GOTENBERG_PORT=3000
