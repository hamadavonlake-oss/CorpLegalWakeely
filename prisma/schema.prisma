// ═══════════════════════════════════════════════════════════════
// Global Legal Operations Platform — Prisma Schema (Phase 1)
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───

enum LegalRequestStatus {
  draft
  submitted
  triaged
  in_progress
  converted_to_matter
  closed
  cancelled
  rejected
  waiting_for_information
}

enum MatterStatus {
  open
  in_progress
  on_hold
  waiting_for_information
  resolved
  closed
  archived
  cancelled
}

enum ContractStatus {
  draft
  under_review
  changes_requested
  pending_approval
  approved
  pending_signature
  signed
  active
  expired
  terminated
  archived
  rejected
  draft_new_version
}

enum DocumentStatus {
  draft
  under_review
  changes_requested
  approved
  exported
  filed
  archived
}

enum ApprovalDecision {
  approved
  rejected
  changes_requested
}

enum ApprovalStepType {
  sequential
  parallel
}

enum ConflictCheckStatus {
  not_checked
  no_match
  possible_match
  requires_review
  cleared_by_lawyer
  blocked
}

enum SignatureStatus {
  pending
  signed
  declined
  unknown
}

enum NotificationStatus {
  unread
  read
  delivered
  failed
}

enum ClassificationLevel {
  public
  internal
  confidential
  restricted
}

enum VirusScanStatus {
  pending
  clean
  infected
  error
}

/// Polymorphic parent type for ConflictCheck.
/// Phase 2 supports `matter` only — `contract` will be enabled in Phase 3.
enum ConflictCheckParentType {
  matter
  contract
}

enum UserStatus {
  active
  locked
  disabled
}

// ═══════════════════════════════════════════════════════════════
// Reference Data
// ═══════════════════════════════════════════════════════════════

model Country {
  id        String   @id
  code      String   @unique
  name      String
  nameEn    String?  @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  locales   Locale[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("countries")
}

model Locale {
  id          String @id @default(uuid())
  countryCode String @map("country_code")
  code        String
  name        String
  isRtl       Boolean @default(false) @map("is_rtl")
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  country Country @relation(fields: [countryCode], references: [id])

  @@unique([countryCode, code])
  @@map("locales")
}

model Currency {
  id        String @id
  code      String @unique
  name      String
  nameEn    String?  @map("name_en")
  symbol    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("currencies")
}

// ═══════════════════════════════════════════════════════════════
// Core Tables
// ═══════════════════════════════════════════════════════════════

model Organization {
  id          String   @id @default(uuid())
  name        String
  nameEn      String?  @map("name_en")
  slug        String   @unique
  countryPack String?  @map("country_pack")
  settings    Json?    @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  rowVersion  Int      @default(0) @map("row_version")

  settingsRel    OrganizationSetting?
  entities       Entity[]
  departments    Department[]
  users          User[]
  roles          Role[]
  legalRequests  LegalRequest[]
  matters        Matter[]
  conflictChecks ConflictCheck[]
  contracts      Contract[]
  contractParties ContractParty[]
  contractValues  ContractValue[]
  contractSignatures ContractSignature[]
  contractDocumentLinks ContractDocumentLink[]
  documents      Document[]
  documentVersions DocumentVersion[]
  templates      Template[]
  clauses        Clause[]
  templateClauses TemplateClause[]
  approvalRules  ApprovalRule[]
  approvalRuleConditions ApprovalRuleCondition[]
  approvalRuleSteps ApprovalRuleStep[]
  approvalInstances ApprovalInstance[]
  approvalInstanceSteps ApprovalInstanceStep[]
  notifications  Notification[]
  notificationPreferences NotificationPreference[]
  deadlines      Deadline[]

  @@map("organizations")
}

model OrganizationSetting {
  id               String   @id @default(uuid())
  organizationId   String   @unique @map("organization_id")
  defaultLocale    String   @default("ar") @map("default_locale")
  defaultTimezone  String   @default("Asia/Amman") @map("default_timezone")
  defaultCurrency  String   @default("JOD") @map("default_currency")
  mfaMandatory     Boolean  @default(false) @map("mfa_mandatory")
  retentionDays    Int?     @map("retention_days")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_settings")
}

model Entity {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  nameEn         String?  @map("name_en")
  legalName      String?  @map("legal_name")
  registrationNo String?  @map("registration_no")
  countryCode    String   @map("country_code")
  entityType     String?  @map("entity_type")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")
  rowVersion     Int     @default(0) @map("row_version")

  organization    Organization @relation(fields: [organizationId], references: [id])
  departments     Department[]
  legalRequests   LegalRequest[]
  matters         Matter[]
  contracts       Contract[]
  contractParties ContractParty[]

  @@unique([organizationId, registrationNo])
  @@map("entities")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  entityId       String   @map("entity_id")
  name           String
  nameEn         String?  @map("name_en")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  entity       Entity       @relation(fields: [entityId], references: [id])

  @@map("departments")
}

// ═══════════════════════════════════════════════════════════════
// Identity & Auth
// ═══════════════════════════════════════════════════════════════

model User {
  id               String      @id @default(uuid())
  organizationId   String      @map("organization_id")
  email            String
  passwordHash     String      @map("password_hash")
  firstName        String      @map("first_name")
  firstNameEn      String?     @map("first_name_en")
  lastName         String      @map("last_name")
  lastNameEn       String?     @map("last_name_en")
  displayName      String      @map("display_name")
  avatarUrl        String?     @map("avatar_url")
  status           UserStatus  @default(active)
  mfaEnabled       Boolean     @default(false) @map("mfa_enabled")
  mfaSecret        String?     @map("mfa_secret")
  lastLoginAt      DateTime?   @map("last_login_at")
  failedLoginCount Int         @default(0) @map("failed_login_count")
  lockedUntil      DateTime?   @map("locked_until")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")
  deletedBy        String?     @map("deleted_by")
  rowVersion       Int         @default(0) @map("row_version")

  organization Organization @relation(fields: [organizationId], references: [id])
  roles       UserRole[]
  sessions    AuthSession[]
  auditLogs   AuditLog[]

  @@unique([organizationId, email])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  deviceLabel      String?   @map("device_label")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime?  @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("auth_sessions")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  code           String   @unique
  name           String
  nameEn         String?  @map("name_en")
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization?    @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameEn    String?  @map("name_en")
  module    String
  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedBy String?  @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════════════════
// Legal Operations
// ═══════════════════════════════════════════════════════════════

model LegalRequest {
  id               String              @id @default(uuid())
  organizationId   String              @map("organization_id")
  entityId         String?             @map("entity_id")
  requestNumber    String              @map("request_number")
  title            String
  titleEn          String?             @map("title_en")
  description      String?
  type             String?
  priority         String?             @default("medium")
  status           LegalRequestStatus  @default(draft)
  requestedBy      String              @map("requested_by")
  assignedTo       String?             @map("assigned_to")
  classification   ClassificationLevel @default(internal)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")
  deletedBy        String?             @map("deleted_by")
  rowVersion       Int                 @default(0) @map("row_version")

  organization Organization @relation(fields: [organizationId], references: [id])
  entity       Entity?      @relation(fields: [entityId], references: [id])
  matterLinks  LegalRequestMatterLink[]
  documents    Document[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
  @@index([requestedBy])
  @@index([assignedTo])
  @@map("legal_requests")
}

model LegalRequestMatterLink {
  id        String   @id @default(uuid())
  requestId String   @map("request_id")
  matterId  String   @map("matter_id")
  linkedBy  String   @map("linked_by")
  createdAt DateTime @default(now()) @map("created_at")

  request LegalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  matter  Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@unique([requestId, matterId])
  @@map("legal_request_matter_links")
}

model Matter {
  id               String      @id @default(uuid())
  organizationId   String      @map("organization_id")
  entityId         String?     @map("entity_id")
  matterNumber     String      @map("matter_number")
  title            String
  titleEn          String?     @map("title_en")
  description      String?
  type             String?
  status           MatterStatus @default(open)
  priority         String?     @default("medium")
  assignedTo       String?     @map("assigned_to")
  responsibleUser  String?     @map("responsible_user")
  classification   ClassificationLevel @default(internal)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")
  deletedBy        String?   @map("deleted_by")
  rowVersion       Int         @default(0) @map("row_version")

  organization Organization @relation(fields: [organizationId], references: [id])
  entity       Entity?                   @relation(fields: [entityId], references: [id])
  requestLinks LegalRequestMatterLink[]
  contracts    Contract[]
  documents    Document[]

  @@unique([organizationId, matterNumber])
  @@index([organizationId, status])
  @@index([assignedTo])
  @@map("matters")
}

/// Conflict Check — administrative record of a manual conflict-of-interest
/// check. NO automated legal analysis, NO AI/OCR. Names in Arabic + English,
/// registration numbers, and a 6-state status. Polymorphic parent
/// (matter or contract) — Phase 2 only supports matter. The relation to
/// Matter/Contract is enforced at the application layer via parent_type +
/// parent_id, NOT via a Prisma relation, because Prisma does not support
/// polymorphic relations natively.
model ConflictCheck {
  id              String                @id @default(uuid())
  organizationId  String                @map("organization_id")
  parentType      ConflictCheckParentType @map("parent_type")
  parentId        String                @map("parent_id")
  status          ConflictCheckStatus   @default(not_checked)
  /// JSON array of { name, name_en } — names searched for conflicts.
  names           Json                  @default("[]") @db.JsonB
  /// JSON array of registration numbers searched.
  registrationNumbers Json?             @map("registration_numbers") @db.JsonB
  notes           String?
  checkedBy       String?               @map("checked_by")
  checkedAt       DateTime?             @map("checked_at")
  /// Optional free-text result summary captured by the lawyer/admin.
  resultSummary   String?               @map("result_summary")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")
  deletedBy       String?               @map("deleted_by")
  rowVersion      Int                   @default(0) @map("row_version")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([parentType, parentId])
  @@index([organizationId, status])
  @@index([parentType, parentId])
  @@index([checkedBy])
  @@map("conflict_checks")
}

// ═══════════════════════════════════════════════════════════════
// Contracts (Phase 3)
// ═══════════════════════════════════════════════════════════════

/// Contract — 13-state machine per build-pack/02-mvp-prd.md.
/// Links to Matter (optional), Entity (optional), and has many parties,
/// values, signature records, and document links.
model Contract {
  id               String         @id @default(uuid())
  organizationId   String         @map("organization_id")
  entityId         String?        @map("entity_id")
  matterId         String?        @map("matter_id")
  contractNumber   String         @map("contract_number")
  title            String
  titleEn          String?        @map("title_en")
  description      String?
  type             String?
  /// Free-text category: e.g. 'nda', 'saas', 'employment', 'vendor'.
  category         String?
  status           ContractStatus @default(draft)
  priority         String?        @default("medium")
  /// ISO date string (YYYY-MM-DD). Effective date when contract becomes active.
  effectiveDate    DateTime?      @map("effective_date")
  /// ISO date string. When the contract expires (if applicable).
  expiryDate       DateTime?      @map("expiry_date")
  /// Counterparty identifier (free text) — full party info in ContractParty.
  counterpartyName String?        @map("counterparty_name")
  counterpartyNameEn String?      @map("counterparty_name_en")
  /// Contract value summary (for dashboard display). Detailed breakdown in ContractValue.
  totalValue       Decimal?       @map("total_value") @db.Decimal(18, 3)
  totalCurrency    String?        @map("total_currency")
  assignedTo       String?        @map("assigned_to")
  createdBy        String         @map("created_by")
  classification   ClassificationLevel @default(internal)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")
  deletedBy        String?        @map("deleted_by")
  rowVersion       Int            @default(0) @map("row_version")

  organization Organization     @relation(fields: [organizationId], references: [id])
  entity       Entity?           @relation(fields: [entityId], references: [id])
  matter       Matter?           @relation(fields: [matterId], references: [id])
  parties      ContractParty[]
  values       ContractValue[]
  signatures   ContractSignature[]
  documentLinks ContractDocumentLink[]
  documents    Document[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId, status])
  @@index([matterId])
  @@index([entityId])
  @@index([assignedTo])
  @@index([effectiveDate])
  @@index([expiryDate])
  @@map("contracts")
}

/// Contract Party — internal or external party to a contract.
/// A contract has many parties, each with a role (e.g. 'buyer', 'seller',
/// 'guarantor'). External parties are free-text; internal parties link
/// to an Entity within the organization.
model ContractParty {
  id              String   @id @default(uuid())
  contractId      String   @map("contract_id")
  organizationId  String   @map("organization_id")
  /// 'internal' links to an Entity; 'external' is free-text.
  partyType       String   @map("party_type")
  entityId        String?  @map("entity_id")
  /// Free-text name for external parties, or display override for internal.
  name            String
  nameEn          String?  @map("name_en")
  /// Role of this party in the contract: 'buyer', 'seller', 'guarantor', etc.
  role            String
  /// Contact info: email, phone, address (JSON object).
  contactInfo     Json?    @map("contact_info") @db.JsonB
  registrationNo  String?  @map("registration_no")
  taxId           String?  @map("tax_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id])
  entity        Entity?       @relation(fields: [entityId], references: [id])

  @@index([contractId])
  @@index([organizationId])
  @@index([entityId])
  @@map("contract_parties")
}

/// Contract Value — financial breakdown of a contract.
/// A contract can have multiple value lines (base price, taxes, fees).
model ContractValue {
  id              String   @id @default(uuid())
  contractId      String   @map("contract_id")
  organizationId  String   @map("organization_id")
  /// Type of value: 'base', 'tax', 'fee', 'discount', 'penalty'.
  valueType       String   @map("value_type")
  description     String?
  amount          Decimal  @db.Decimal(18, 3)
  currency        String
  /// For multi-year contracts, the year this value applies to (1-indexed).
  year            Int?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@index([contractId])
  @@index([organizationId])
  @@map("contract_values")
}

/// Contract Signature — manual signature tracking (no e-signature per Rule 4).
/// Each row records one signer's signature status + uploaded signed copy.
model ContractSignature {
  id              String          @id @default(uuid())
  contractId      String          @map("contract_id")
  organizationId  String          @map("organization_id")
  /// Signer's full name (free text — may be external).
  signerName      String          @map("signer_name")
  signerNameEn    String?         @map("signer_name_en")
  /// Signer's title/role: 'CEO', 'CFO', 'Legal Counsel', etc.
  signerTitle     String?         @map("signer_title")
  /// For internal signers, link to a user; for external, null.
  signerUserId    String?         @map("signer_user_id")
  /// Order in the signing sequence (1 = first signer).
  sequence        Int             @default(1)
  status          SignatureStatus @default(pending)
  signedAt        DateTime?       @map("signed_at")
  /// Path/URL to the uploaded signed page or full signed copy.
  signedDocumentUrl String?       @map("signed_document_url")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@index([contractId])
  @@index([organizationId])
  @@index([signerUserId])
  @@map("contract_signatures")
}

/// Contract-Document link. Connects a contract to its related documents
/// (source draft, signed copy, amendments, exhibits).
model ContractDocumentLink {
  id              String   @id @default(uuid())
  contractId      String   @map("contract_id")
  organizationId  String   @map("organization_id")
  documentId      String   @map("document_id")
  /// Type of link: 'source', 'signed_copy', 'amendment', 'exhibit'.
  linkType        String   @map("link_type")
  createdAt       DateTime @default(now()) @map("created_at")

  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@unique([contractId, documentId, linkType])
  @@index([contractId])
  @@index([documentId])
  @@index([organizationId])
  @@map("contract_document_links")
}

// ═══════════════════════════════════════════════════════════════
// Documents & Templates (Phase 4)
// ═══════════════════════════════════════════════════════════════

/// Document — top-level metadata for a managed document. Binary content
/// lives in S3/MinIO via signed URLs (ADR-004). Immutable once approved:
/// changes create a new DocumentVersion row, never overwrite the existing one.
model Document {
  id              String         @id @default(uuid())
  organizationId  String         @map("organization_id")
  /// Optional link to a contract, matter, or legal request.
  contractId      String?        @map("contract_id")
  matterId        String?        @map("matter_id")
  legalRequestId  String?        @map("legal_request_id")
  /// Stable identifier across versions (e.g., "NDA-Acme-2026").
  /// The Document row is the logical document; DocumentVersion rows are
  /// the actual revisions.
  documentNumber  String         @map("document_number")
  title           String
  titleEn         String?        @map("title_en")
  description     String?
  /// Document type: 'contract_draft', 'signed_contract', 'exhibit',
  /// 'evidence', 'correspondence', 'memo', 'other'.
  type            String
  /// Current status of the document (7-state machine).
  status          DocumentStatus @default(draft)
  classification  ClassificationLevel @default(internal)
  /// MIME type of the latest version (e.g., 'application/vnd.openxmlformats-officedocument.wordprocessingml.document').
  mimeType        String?        @map("mime_type")
  /// Size in bytes of the latest version's binary.
  sizeBytes       Int?           @map("size_bytes")
  /// SHA-256 hash of the latest version's binary content (integrity check).
  contentHash     String?        @map("content_hash")
  /// Virus scan status of the latest version.
  virusScanStatus VirusScanStatus @default(pending) @map("virus_scan_status")
  /// Latest version number (1, 2, 3, ...). Incremented on each new version.
  currentVersion  Int            @default(1) @map("current_version")
  uploadedBy      String         @map("uploaded_by")
  approvedBy      String?        @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  /// If true, prevents permanent deletion (Legal Hold per Rule 10).
  legalHold       Boolean        @default(false) @map("legal_hold")
  /// Retention policy: when the document can be permanently deleted.
  retentionUntil  DateTime?      @map("retention_until")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")
  deletedBy       String?        @map("deleted_by")
  rowVersion      Int             @default(0) @map("row_version")

  organization Organization     @relation(fields: [organizationId], references: [id])
  contract     Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  matter       Matter?           @relation(fields: [matterId], references: [id], onDelete: SetNull)
  legalRequest LegalRequest?    @relation(fields: [legalRequestId], references: [id], onDelete: SetNull)
  versions     DocumentVersion[]
  contractDocumentLinks ContractDocumentLink[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId, status])
  @@index([contractId])
  @@index([matterId])
  @@index([legalRequestId])
  @@index([uploadedBy])
  @@index([status])
  @@map("documents")
}

/// Document Version — immutable revision of a document. Each version
/// stores its own S3 key + content hash. Approved versions CANNOT be
/// modified (Rule 12: immutable approved document versions).
model DocumentVersion {
  id              String         @id @default(uuid())
  documentId      String         @map("document_id")
  organizationId  String         @map("organization_id")
  versionNumber   Int            @map("version_number")
  /// S3 object key (bucket + key). Signed URL generated on demand.
  storageKey      String         @map("storage_key")
  /// Original filename from upload.
  filename        String
  mimeType        String         @map("mime_type")
  sizeBytes       Int            @map("size_bytes")
  /// SHA-256 hash of the binary content (integrity verification).
  contentHash     String         @map("content_hash")
  /// What changed in this version vs the previous one (free text).
  changeSummary   String?        @map("change_summary")
  /// Who uploaded/created this version.
  uploadedBy      String         @map("uploaded_by")
  /// Whether this version has been approved (approved versions are immutable).
  approvedBy      String?        @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  virusScanStatus VirusScanStatus @default(pending) @map("virus_scan_status")
  createdAt       DateTime       @default(now()) @map("created_at")

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([organizationId])
  @@index([contentHash])
  @@map("document_versions")
}

/// Template — DOCX template that can be filled from request/matter/contract
/// data using docxtemplater. Stored in S3 like documents.
model Template {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  templateCode    String   @map("template_code")
  name            String
  nameEn          String?  @map("name_en")
  description     String?
  /// Type of template: 'contract', 'letter', 'memo', 'notice', 'clause_set'.
  type            String
  /// S3 object key for the DOCX template file.
  storageKey      String   @map("storage_key")
  filename        String
  /// JSON schema describing the variables the template expects.
  /// Example: { "contract_title": "string", "effective_date": "date", "party_name": "string" }
  variablesSchema Json?    @map("variables_schema") @db.JsonB
  /// Default values for some variables (JSON object).
  defaultValues   Json?    @map("default_values") @db.JsonB
  /// Country code this template is designed for (for locale formatting).
  countryCode     String?  @map("country_code")
  /// Locale: 'ar', 'en', or 'ar,en' for bilingual.
  locale          String   @default("ar")
  /// Version of the template file (incremented when the DOCX is updated).
  version         Int      @default(1)
  isActive        Boolean  @default(true) @map("is_active")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?  @map("deleted_by")
  rowVersion      Int      @default(0) @map("row_version")

  organization Organization @relation(fields: [organizationId], references: [id])
  clauses       TemplateClause[]

  @@unique([organizationId, templateCode])
  @@index([organizationId, type])
  @@index([organizationId, isActive])
  @@map("templates")
}

/// Clause — reusable clause text that can be inserted into templates.
/// Each clause has AR + EN text and a category for organization.
model Clause {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  code            String
  title           String
  titleEn         String?  @map("title_en")
  /// Category: 'boilerplate', 'termination', 'confidentiality', 'payment', etc.
  category        String
  /// Clause body in Arabic (or primary language).
  bodyText        String   @map("body_text")
  /// Clause body in English (or secondary language).
  bodyTextEn      String?  @map("body_text_en")
  /// Optional variables this clause uses (JSON array of variable names).
  variables       Json?    @db.JsonB
  /// Country code this clause is designed for.
  countryCode     String?  @map("country_code")
  /// Whether this clause is currently active.
  isActive        Boolean  @default(true) @map("is_active")
  /// Version of the clause text (incremented on edits).
  version         Int      @default(1)
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?  @map("deleted_by")
  rowVersion      Int      @default(0) @map("row_version")

  organization Organization   @relation(fields: [organizationId], references: [id])
  templateLinks TemplateClause[]

  @@unique([organizationId, code])
  @@index([organizationId, category])
  @@index([organizationId, isActive])
  @@map("clauses")
}

/// Template-Clause link — many-to-many between templates and clauses.
/// Each link specifies where in the template the clause should be inserted
/// (via a placeholder variable name).
model TemplateClause {
  id              String   @id @default(uuid())
  templateId      String   @map("template_id")
  clauseId        String   @map("clause_id")
  organizationId  String   @map("organization_id")
  /// The variable name in the template DOCX that this clause fills.
  /// Example: {clause_termination} in the template → this clause's body text.
  placeholderName String   @map("placeholder_name")
  /// Order in which clauses are inserted (for multi-clause placeholders).
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  template      Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  clause        Clause        @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@unique([templateId, clauseId, placeholderName])
  @@index([templateId])
  @@index([clauseId])
  @@index([organizationId])
  @@map("template_clauses")
}

// ═══════════════════════════════════════════════════════════════
// Approvals (Phase 5)
// ═══════════════════════════════════════════════════════════════
//
// Two-tier design:
// 1. ApprovalRule + ApprovalRuleCondition + ApprovalRuleStep — the
//    *template* configured by legal admins: "for vendor contracts
//    over $50k, require sequential approval from Legal → Finance → CEO"
// 2. ApprovalInstance + ApprovalInstanceStep — the *runtime* record
//    created when a contract/document is submitted for approval.
//    Each step has a status (pending/approved/rejected/changes_requested/
//    delegated/skipped/escalated) and links to a specific user.
//
// Per ADR-008: sequential/parallel/delegation approvals with escalation.

/// ApprovalRule — a configurable approval template.
/// When a contract/document is submitted for approval, the engine finds
/// the first matching rule (by conditions) and creates an ApprovalInstance
/// from its steps.
model ApprovalRule {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  /// A human-readable name for this rule (e.g. "Vendor contracts > $50k")
  name            String
  nameEn          String?  @map("name_en")
  description     String?
  /// What this rule applies to: 'contract' or 'document'.
  objectType      String   @map("object_type")
  /// Priority for rule matching (lower number = higher priority).
  /// When multiple rules match, the one with the lowest priority value
  /// is selected.
  priority        Int      @default(100)
  /// Approval type: 'sequential' (steps run in order) or 'parallel'
  /// (all steps run at once, all must approve).
  approvalType    String   @default("sequential") @map("approval_type")
  /// Whether this rule is currently active.
  isActive        Boolean  @default(true) @map("is_active")
  /// If true, an approved instance of this rule is required before the
  /// object can transition to 'approved' status.
  isRequired      Boolean  @default(true) @map("is_required")
  /// Escalation: minutes before a pending step is auto-escalated.
  /// null = no escalation.
  escalationMinutes Int?  @map("escalation_minutes")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?  @map("deleted_by")
  rowVersion      Int      @default(0) @map("row_version")

  organization Organization           @relation(fields: [organizationId], references: [id])
  conditions   ApprovalRuleCondition[]
  steps        ApprovalRuleStep[]
  instances    ApprovalInstance[]

  @@index([organizationId, objectType, isActive])
  @@index([organizationId, priority])
  @@map("approval_rules")
}

/// ApprovalRuleCondition — a single condition that must match for the
/// rule to apply. Multiple conditions on a rule are AND'd together.
/// Example: { field: 'type', operator: 'equals', value: 'vendor_agreement' }
///          { field: 'total_value', operator: 'greater_than', value: '50000' }
model ApprovalRuleCondition {
  id              String   @id @default(uuid())
  ruleId          String   @map("rule_id")
  organizationId  String   @map("organization_id")
  /// The field to evaluate. Supported: 'type', 'category', 'total_value',
  /// 'total_currency', 'country_code', 'entity_id', 'classification'.
  field           String
  /// Comparison operator: 'equals', 'not_equals', 'greater_than',
  /// 'less_than', 'greater_than_or_equal', 'less_than_or_equal',
  /// 'in', 'contains'.
  operator        String
  /// The comparison value (string; for numeric fields it's parsed).
  /// For 'in' operator, this is a comma-separated list.
  value           String
  createdAt       DateTime @default(now()) @map("created_at")

  rule       ApprovalRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([ruleId])
  @@index([organizationId])
  @@map("approval_rule_conditions")
}

/// ApprovalRuleStep — a step in the approval template.
/// For sequential rules, steps run in order of `stepOrder`.
/// For parallel rules, all steps run at once.
model ApprovalRuleStep {
  id              String   @id @default(uuid())
  ruleId          String   @map("rule_id")
  organizationId  String   @map("organization_id")
  stepOrder       Int      @map("step_order")
  /// Name for this step (e.g. "Legal Review", "Finance Approval", "CEO Sign-off")
  name            String
  nameEn          String?  @map("name_en")
  /// Which role should approve this step. The actual user is resolved at
  /// runtime from the contract's assignedTo + the organization's roles.
  /// If `assignedUserId` is set, that specific user is used instead.
  approverRole    String?  @map("approver_role")
  /// Specific user ID to assign this step to (overrides role-based assignment).
  assignedUserId  String?  @map("assigned_user_id")
  /// Whether delegation is allowed for this step.
  canDelegate     Boolean  @default(false) @map("can_delegate")
  /// Whether this step can be skipped (auto-approved).
  canSkip         Boolean  @default(false) @map("can_skip")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  rule       ApprovalRule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id])
  instances  ApprovalInstanceStep[]

  @@index([ruleId])
  @@index([organizationId])
  @@map("approval_rule_steps")
}

/// ApprovalInstance — a runtime approval flow created when a contract
/// or document is submitted for approval. Linked to a rule (which
/// defines the steps) and to the object being approved.
model ApprovalInstance {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  ruleId          String   @map("rule_id")
  /// What's being approved: 'contract' or 'document'.
  objectType      String   @map("object_type")
  objectId        String   @map("object_id")
  /// Current status of the instance:
  /// 'pending' (in progress), 'approved' (all steps approved),
  /// 'rejected' (any step rejected), 'changes_requested' (returned for edits),
  /// 'cancelled' (cancelled before completion), 'expired' (escalation timeout)
  status          String   @default("pending")
  /// Which step is currently active (for sequential rules).
  /// null = all steps complete or running in parallel.
  currentStepOrder Int?   @map("current_step_order")
  /// When the instance was submitted.
  submittedAt     DateTime @default(now()) @map("submitted_at")
  /// When the instance was completed (approved/rejected/cancelled).
  completedAt     DateTime? @map("completed_at")
  submittedBy     String   @map("submitted_by")
  /// Free-text notes from the submitter.
  submitNotes     String?  @map("submit_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  rule       ApprovalRule           @relation(fields: [ruleId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id])
  steps      ApprovalInstanceStep[]

  @@index([organizationId, objectType, objectId])
  @@index([organizationId, status])
  @@index([ruleId])
  @@map("approval_instances")
}

/// ApprovalInstanceStep — runtime record for a single step's approval.
model ApprovalInstanceStep {
  id              String   @id @default(uuid())
  instanceId      String   @map("instance_id")
  organizationId  String   @map("organization_id")
  ruleStepId      String?  @map("rule_step_id")
  stepOrder       Int      @map("step_order")
  name            String
  nameEn          String?  @map("name_en")
  /// The user assigned to approve this step. May change due to delegation.
  assignedTo      String   @map("assigned_to")
  /// Original assignee (before delegation). null if no delegation.
  originalAssignee String? @map("original_assignee")
  /// Status of this step:
  /// 'pending', 'approved', 'rejected', 'changes_requested',
  /// 'delegated', 'skipped', 'escalated'
  status          String   @default("pending")
  decidedBy       String?  @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  decisionNotes   String?  @map("decision_notes")
  /// For delegation: who this step was delegated to.
  delegatedTo     String?  @map("delegated_to")
  /// For escalation: when this step was escalated.
  escalatedAt     DateTime? @map("escalated_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  instance    ApprovalInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  ruleStep    ApprovalRuleStep? @relation(fields: [ruleStepId], references: [id])
  organization Organization      @relation(fields: [organizationId], references: [id])

  @@index([instanceId])
  @@index([organizationId, status])
  @@index([assignedTo])
  @@index([ruleStepId])
  @@map("approval_instance_steps")
}

// ═══════════════════════════════════════════════════════════════
// Notifications (Phase 6)
// ═══════════════════════════════════════════════════════════════
//
// Per ADR-011 / build-pack/02-mvp-prd.md:
// - In-app notifications via Server-Sent Events (SSE)
// - Persistent notification storage (survives reloads)
// - Polling fallback for clients that can't use SSE
// - Email notification stubs (real email deferred to Phase 8)
// - User notification preferences

/// Notification — a single in-app notification for a user.
/// Persisted in PostgreSQL; delivered via SSE or polling.
model Notification {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  /// Who the notification is for.
  userId          String   @map("user_id")
  /// Notification type (drives icon + routing in UI).
  /// Examples: 'request.submitted', 'request.assigned', 'matter.created',
  /// 'matter.status_changed', 'approval.needed', 'approval.decision',
  /// 'contract.status_changed', 'document.uploaded', 'deadline.approaching'
  type            String
  /// Short title (AR or EN based on user's locale).
  title           String
  /// Longer body text (1-2 sentences).
  body            String
  /// Severity: 'info', 'success', 'warning', 'error'.
  severity        String   @default("info")
  /// Optional link to navigate to when clicked (e.g. '/matters/mtr-1').
  actionUrl       String?  @map("action_url")
  /// Optional related object (for grouping/filters).
  objectType      String?  @map("object_type")
  objectId        String?  @map("object_id")
  /// Whether the notification has been read by the user.
  readAt          DateTime? @map("read_at")
  /// When the notification was created.
  createdAt       DateTime @default(now()) @map("created_at")
  /// Optional: when the notification should be delivered (for scheduled reminders).
  scheduledFor    DateTime? @map("scheduled_for")
  /// Delivery status: 'pending', 'delivered', 'failed'.
  deliveryStatus  String   @default("delivered") @map("delivery_status")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, userId, readAt])
  @@index([userId, createdAt])
  @@index([organizationId, type])
  @@index([scheduledFor])
  @@map("notifications")
}

/// NotificationPreference — per-user preferences for which notifications
/// they want to receive, and via which channels (in-app, email).
model NotificationPreference {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  userId          String   @unique @map("user_id")
  /// Master toggle. If false, no notifications at all.
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  /// Email notifications (Phase 8 will wire real email).
  emailEnabled    Boolean  @default(false) @map("email_enabled")
  /// JSON object of enabled notification types.
  /// Example: { "request.submitted": true, "approval.needed": true, "deadline.approaching": true }
  /// If a type is missing, it defaults to enabled.
  enabledTypes    Json?    @map("enabled_types") @db.JsonB
  /// Digest frequency: 'instant', 'hourly', 'daily', 'weekly'.
  digestFrequency String   @default("instant") @map("digest_frequency")
  /// Quiet hours: don't send notifications between these times.
  /// Format: { "start": "22:00", "end": "07:00", "timezone": "Asia/Amman" }
  quietHours      Json?    @map("quiet_hours") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("notification_preferences")
}

// ═══════════════════════════════════════════════════════════════
// Deadlines (Phase 7)
// ═══════════════════════════════════════════════════════════════

/// Deadline — a tracked due date for a matter, contract, or request.
/// When a deadline is approaching (configurable reminder days before),
/// the system sends a notification to the assigned user.
model Deadline {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  /// What the deadline is for: 'matter', 'contract', 'request'.
  parentType      String   @map("parent_type")
  parentId        String   @map("parent_id")
  /// Title of the deadline (e.g. "Filing deadline", "Response to court").
  title           String
  titleEn         String?  @map("title_en")
  description     String?
  /// When the deadline is due.
  dueDate         DateTime @map("due_date")
  /// Days before dueDate to send a reminder (default 7).
  reminderDays    Int      @default(7) @map("reminder_days")
  /// Whether the reminder has been sent.
  reminderSent    Boolean  @default(false) @map("reminder_sent")
  /// Who is responsible for meeting the deadline.
  assignedTo      String?  @map("assigned_to")
  /// Status: 'pending', 'completed', 'overdue', 'cancelled'.
  status          String   @default("pending")
  completedAt     DateTime? @map("completed_at")
  /// Priority for sorting on the dashboard: 'low', 'medium', 'high', 'urgent'.
  priority        String   @default("medium")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?  @map("deleted_by")
  rowVersion      Int      @default(0) @map("row_version")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, parentType, parentId])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, dueDate])
  @@index([assignedTo])
  @@map("deadlines")
}

// ═══════════════════════════════════════════════════════════════
// Audit Log
// ═══════════════════════════════════════════════════════════════

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorId        String   @map("actor_id")
  actorEmail     String?  @map("actor_email")
  action         String
  objectType     String   @map("object_type")
  objectId       String   @map("object_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  correlationId   String   @map("correlation_id")
  beforeState    Json?    @map("before") @db.JsonB
  afterState     Json?    @map("after") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")
  hashChain      String?  @map("hash_chain")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([objectType, objectId])
  @@index([createdAt])
  @@map("audit_logs")
}
